 },
 {
  "id": 528,
  "platform": "NES / Famicom",
  "game": "Metroid",
  "target": "Brinstar Roots, Norfair Magma & Tourian Halls",
  "url": "https://strategywiki.org/wiki/Metroid/Gameplay",
  "page_title": "Metroid/Brinstar",
  "section_count": 5,
  "description": "Brinstar Roots, Norfair Magma & Tourian Halls, Metroid (NES / Famicom). Samus' mission begins in an area of tunnels called Brinstar. This is the easiest area of the planet to clear, so use it to learn all of Samus' moves. As a result, it has been split up into two parts so that it can fit inside most browser displays.",
  "qwen_prompt": "Generate a fully interactive 3D WebGL Three.js world representing 'Brinstar Roots, Norfair Magma & Tourian Halls' from Metroid (NES / Famicom). The attached reference imagery is the primary guide: match its layout, landmarks, colors and mood. World brief: Brinstar Roots, Norfair Magma & Tourian Halls, Metroid (NES / Famicom). Samus' mission begins in an area of tunnels called Brinstar. This is the easiest area of the planet to clear, so use it to learn all of Samus' moves. As a result, it has been split up into two parts so that it can fit inside most browser displays. Include lighting, fog, textures/materials, animated environmental elements, and mouse/touch orbit camera controls.",
  "description_raw": "Samus' mission begins in an area of tunnels called Brinstar. Here the tunnels are composed mainly of stone and there are long shafts leading up and down. Prepare to meet many dive-bombing Skrees and Rios as you search for Power-Up options. This is the easiest area of the planet to clear, so use it to learn all of Samus' moves. Remember that blue doors must be fired upon to open them. Brinstar is very wide. As a result, it has been split up into two parts so that it can fit inside most browser displays. There is an east portion and a west portion, and they are connected by the bridge that straddles the two long vertical columns found on either side. You begin the game just to the right of label 1 on the map.",
  "brief": "Brinstar Roots, Norfair Magma & Tourian Halls, Metroid (NES / Famicom). Samus' mission begins in an area of tunnels called Brinstar. This is the easiest area of the planet to clear, so use it to learn all of Samus' moves. As a result, it has been split up into two parts so that it can fit inside most browser displays.",
