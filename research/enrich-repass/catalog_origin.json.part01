 },
 {
  "id": 102,
  "platform": "More Atari 2600",
  "game": "Centipede",
  "target": "Mushroom Garden",
  "url": "https://strategywiki.org/wiki/Centipede/Walkthrough",
  "page_title": "Centipede",
  "section_count": 11,
  "description": "Mushroom Garden, Centipede (More Atari 2600). Centipede was quite popular at home as well, thanks to Atari porting it, not only to its own home systems, but to just about every other popular platform through their Atarisoft label. It used bright attractive colors throughout the game that alternated between stages. The object of every stage is simply to eliminate all of the centipede's body segments by shooting up at them, through a multitude of mushrooms.",
  "qwen_prompt": "Generate a fully interactive 3D WebGL Three.js world representing 'Mushroom Garden' from Centipede (More Atari 2600). The attached reference imagery is the primary guide: match its layout, landmarks, colors and mood. World brief: Mushroom Garden, Centipede (More Atari 2600). Centipede was quite popular at home as well, thanks to Atari porting it, not only to its own home systems, but to just about every other popular platform through their Atarisoft label. It used bright attractive colors throughout the game that alternated between stages. The object of every stage is simply to eliminate all of the centipede's body segments by shooting up at them, through a multitude of mushrooms. Include lighting, fog, textures/materials, animated environmental elements, and mouse/touch orbit camera controls.",
  "description_raw": "This is the first game in theCentipedeseries. For other games in the series see theCentipede category. Centipedeis regarded as the first arcade game designed by a woman, Dona Bailey. It arrived in the arcades in1980fromAtariand became an instant hit with men and women alike for a number of reasons. It used bright attractive colors throughout the game that alternated between stages. Additionally, it had a simple and intuitive control interface, atrackball. Along with a single fire button, it was a game that just about anyone could approach and immediately know what to do. Even the side art was very impressive and inviting. The object of every stage is simply to eliminate all of the centipede's body segments by shooting up at them, through a multitude of mushrooms. What made the game novel was that if the centipede was shot in the middle, it split up into two separate body segments, each w",
  "brief": "Mushroom Garden, Centipede (More Atari 2600). Centipede was quite popular at home as well, thanks to Atari porting it, not only to its own home systems, but to just about every other popular platform through their Atarisoft label. It used bright attractive colors throughout the game that alternated between stages. The object of every stage is simply to eliminate all of the centipede's body segments by shooting up at them, through a multitude of mushrooms.",
  "image_url": null,
  "image_kind": null,
  "image_urls": [],
  "image_kinds": []
 },
 {
  "id": 103,
  "platform": "More Atari 2600",
  "game": "Missile Command",
  "target": "Coastal Silo Grid",
  "url": "https://strategywiki.org/wiki/Missile_Command/Walkthrough",
  "page_title": "Missile Command",
  "section_count": 1,
  "description": "Coastal Silo Grid, Missile Command (More Atari 2600). Missile Command was so popular, that some variation of the game made its way onto nearly every available platform in the early 80s and beyond whether it was an official conversion or not. Several antiballistic missile bases have been established within the cities of Zardon. This is the first game in theMissile Commandseries.",
  "qwen_prompt": "Generate a fully interactive 3D WebGL Three.js world representing 'Coastal Silo Grid' from Missile Command (More Atari 2600). The attached reference imagery is the primary guide: match its layout, landmarks, colors and mood. World brief: Coastal Silo Grid, Missile Command (More Atari 2600). Missile Command was so popular, that some variation of the game made its way onto nearly every available platform in the early 80s and beyond whether it was an official conversion or not. Several antiballistic missile bases have been established within the cities of Zardon. This is the first game in theMissile Commandseries. Include lighting, fog, textures/materials, animated environmental elements, and mouse/touch orbit camera controls.",
  "description_raw": "This is the first game in theMissile Commandseries. For other games in the series see theMissile Command category. Missile Commandis a1980arcade game byAtarithat was also licensed toSegafor European release. It was an immensely popular game that combined great game play with a rather chilling message about the dangers of war. Originally called 'Armageddon', Missile Command was designed at a time that the United States and Russia were locked in a fierce 'cold war'. Missile Command was originally going to have a large status panel as part of its marquee which indicated the status of the bases and cities but it was eliminated when the designers learned that players lost track of on-screen gameplay when they looked up at the panel. The idea for Missile Command began with a magazine story about satellites that captured the attention of Atari's president, who passed the clipping to Lyle Rains.",
  "brief": "Coastal Silo Grid, Missile Command (More Atari 2600). Missile Command was so popular, that some variation of the game made its way onto nearly every available platform in the early 80s and beyond whether it was an official conversion or not. Several antiballistic missile bases have been established within the cities of Zardon. This is the first game in theMissile Commandseries.",
  "image_url": null,
  "image_kind": null,
